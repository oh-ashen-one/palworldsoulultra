{
  "name": "palworldsoulultra",
  "version": "1.0.0",
  "private": true,
  "description": "Wildkin Frontier — an original 3D creature-survival and camp-automation browser game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/*.js tests/*.mjs vite.config.js eslint.config.js",
    "typecheck": "tsc --project jsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.169.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vite": "^6.0.5"
  }
}
