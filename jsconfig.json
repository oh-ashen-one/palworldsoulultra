{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "strict": false,
    "useDefineForClassFields": true
  },
  "include": [
    "src/wildkin-core.js",
    "tests/wildkin-core.test.mjs",
    "tests/wildkin-golden-path.test.mjs"
  ],
  "exclude": ["node_modules", "dist"]
}
